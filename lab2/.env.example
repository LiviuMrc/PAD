# Copiază în .env (cp .env.example .env). Programele citesc .env din directorul curent;
# variabilele deja setate în mediu au prioritate. Toate au valori implicite.

# Adresa gRPC a brokerului (broker ascultă, sender/receiver se conectează)
BROKER_ADDR=127.0.0.1:50061

# Broker: directorul jurnalului (gol = fără persistență) și fsync după fiecare scriere
BROKER_DATA_DIR=data
BROKER_FSYNC=true
# Broker: mesaje neconfirmate per receiver (peste, cel mai vechi trece în DLQ) și după cât timp
# offline e uitat un receiver (mesajele lui trec în DLQ; 0 = niciodată)
MAX_QUEUE=1000
RECEIVER_TTL_SEC=600
# Broker: mesaje în coada dead-letter; peste, cel mai vechi din DLQ e eliminat (logat ca eroare)
DLQ_MAX=10000
# Broker: cât timp e raportat NOT_SERVING înainte de închiderea conexiunilor
SHUTDOWN_DRAIN_MS=200

# Autentificare (aceeași valoare la broker, sender și receiver; gol = dezactivată)
BROKER_TOKEN=
# TLS (./scripts/certs.sh): brokerul are certificat și cheie, clienții au CA-ul
BROKER_TLS_CERT=
BROKER_TLS_KEY=
BROKER_TLS_CA=
# Reprezentarea pe fir pentru sender/receiver: proto sau json
BROKER_CODEC=proto

# Receiver: reconectări, cât așteaptă o încercare și pauza dintre încercări (secunde)
RECONNECT_MAX=5
CONNECT_TIMEOUT_SEC=2
RECONNECT_INTERVAL_SEC=2

# Sender: deadline per încercare, reîncercări (cu același messageId) și pauza dintre ele
PUBLISH_TIMEOUT_SEC=3
PUBLISH_RETRIES=3
PUBLISH_RETRY_INTERVAL_MS=500
