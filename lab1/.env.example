# Adresa TCP a brokerului (broker ascultă, sender/receiver se conectează)
BROKER_ADDR=127.0.0.1:7000
# Endpoint HTTP pentru health check al brokerului
HEALTH_ADDR=127.0.0.1:7001
# Grupul UDP multicast folosit pentru topicul "broadcast"
MULTICAST_ADDR=239.0.0.1:9999
# Receiver: număr maxim de reconectări și intervalul dintre ele (secunde)
RECONNECT_MAX=5
RECONNECT_INTERVAL_SEC=2
